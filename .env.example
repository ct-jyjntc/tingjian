# 所有密钥仅存在服务器，不使用 NEXT_PUBLIC_ 前缀。
# 推荐在网页“服务与设置 → AI 服务配置”中编辑；网页配置覆盖这里的默认值。
VISION_PROVIDER=tencent
VISION_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
VISION_MODEL=xoppaddleocrv16
VISION_API_KEY=your-full-provider-key

# 默认使用联网 Edge 语音（非官方封装）；界面可显式改选本地 MLX。
TTS_BACKEND=edge-tts
EDGE_TTS_PYTHON=services/edge/.venv/bin/python
# 本地 MLX 配置保留，用于在听写设置中切换。
# 模型大小和量化方式由下面的完整模型 ID 指定。
TTS_MODEL_ID=mlx-community/Qwen3-TTS-12Hz-0.6B-CustomVoice-8bit
TTS_BASE_URL=http://127.0.0.1:8765
TTS_API_STYLE=mlx-openai
TTS_SERVICE_TOKEN=
# 自带 Python 包装服务用 TTS_API_STYLE=project-wrapper 和端口 8766。

# 腾讯官方 SDK：普通一句话识别、通用手写体识别，共用专用子账号凭据。
ASR_PROVIDER=tencent
HANDWRITING_PROVIDER=tencent
TENCENT_SECRET_ID=your-secret-id
TENCENT_SECRET_KEY=your-secret-key
TENCENT_REGION=ap-guangzhou
TENCENT_ASR_ENGINE=16k_zh

# 商汤官方 OpenAI 兼容 HTTP API；此模型已实测 JSON 对话。
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://token.sensenova.cn/v1
LLM_MODEL=sensenova-6.8-flash-lite
LLM_API_KEY=your-api-key
LLM_TOOL_CHOICE=auto
# 模型使用默认推理设置；应用不指定最大输出 tokens。

# 若手动改用其他已确认兼容的 ASR 或手写模型，再设置相应字段：
# ASR_PROVIDER=openai-compatible
ASR_BASE_URL=
ASR_MODEL=
ASR_API_KEY=
# HANDWRITING_PROVIDER=openai-compatible
HANDWRITING_BASE_URL=
HANDWRITING_MODEL=
HANDWRITING_API_KEY=

# 留空时启动脚本仅监听本机；手机/外部访问必须配置强口令及 HTTPS。
APP_ACCESS_TOKEN=
# 默认从 PATH 查找 ffmpeg；Edge 转 WAV 和腾讯录音转 PCM 都需要它。
FFMPEG_PATH=

# 微信小程序公开版本。AppSecret 仅保留在后端；AppID 和 HTTPS 域名是公开信息。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
MINI_API_BASE_URL=
# 开放微信登录前填写实际运营信息和实际接收内容的 AI 服务处理方。
MINI_OPERATOR=
MINI_CONTACT=
MINI_AI_PROCESSORS=
MINI_PRIVACY_VERSION=2026-10-03
# 小程序独立用户数据库，使用持久化磁盘；不可放进 public/ 或代码包。
MINI_DATABASE_FILE=.local/miniprogram.sqlite
MINI_DAILY_CREDITS=200
MINI_GLOBAL_DAILY_CREDITS=5000
# 仅在可信反向代理覆盖 X-Real-IP、且后端禁止公网直连时设置为 1。
MINI_TRUST_PROXY=0
# 启用微信小程序时，上方 APP_ACCESS_TOKEN 必须至少 24 位，仅管理员使用。
