{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "types": ["miniprogram-api-typings"],
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "esModuleInterop": true, "resolveJsonModule": true
  },
  "include": ["**/*.ts"]
}
