page { background: #fbf9f5; color: #30364f; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 28rpx; line-height: 1.65; }
view, button, input, textarea { box-sizing: border-box; }
button { font: inherit; margin: 0; border-radius: 22rpx; padding: 22rpx 28rpx; background: #efeff8; color: #5368b9; font-weight: 600; line-height: 1.5; }
button::after { border: 0; }
button[disabled] { opacity: .42; background: #e7e7ed; color: #85889a; }
.page { padding: 30rpx 36rpx 60rpx; }
.eyebrow { font-size: 21rpx; letter-spacing: 3rpx; font-weight: 600; color: #8990a6; margin-bottom: 12rpx; }
.page-title { font-size: 48rpx; font-weight: 700; letter-spacing: -1.5rpx; line-height: 1.3; }
.section-title { font-size: 33rpx; font-weight: 650; margin-bottom: 12rpx; }
.muted { color: #878b9b; font-size: 25rpx; }
.small { font-size: 22rpx; }
.card { padding: 32rpx; border: 1rpx solid #eceaf0; border-radius: 28rpx; background: #fffefa; margin-top: 26rpx; }
.primary { background: #5368b9; color: white; box-shadow: 0 8rpx 20rpx rgba(83,104,185,.12); }
.secondary { background: #f1f1fb; color: #5368b9; }
.plain { background: transparent; font-weight: 500; color: #828799; padding: 20rpx 18rpx; }
.mini { padding: 12rpx 20rpx; font-size: 24rpx; border-radius: 16rpx; }
.danger { color: #b45d5d; background: #fbefed; }
.row { display: flex; align-items: center; gap: 18rpx; }
.between { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.grow { flex: 1; min-width: 0; }
.stack > button { margin-top: 16rpx; }
.badge { display: inline-block; border-radius: 10rpx; padding: 4rpx 12rpx; font-size: 20rpx; background: #f0effb; color: #6b73ab; }
.badge.warm { background: #fcf0d6; color: #a18345; }
.field-label { color: #70768c; font-size: 24rpx; margin: 26rpx 0 10rpx; }
input, textarea, .picker { background: #f7f7fa; color: #30364f; border: 1rpx solid #e9e9f0; border-radius: 16rpx; width: 100%; padding: 20rpx 24rpx; font-size: 28rpx; }
input { height: 84rpx; }
textarea { min-height: 180rpx; }
.note { color: #8d7d59; background: #fcf5e6; border-radius: 18rpx; padding: 20rpx 24rpx; font-size: 24rpx; margin-top: 20rpx; }
.error { color: #ac5c60; background: #fcf0ef; }
.empty { padding: 68rpx 32rpx; text-align: center; color: #8a8e9f; }
.empty-title { font-size: 30rpx; color: #4d5470; margin-bottom: 10rpx; font-weight: 600; }
.divider { height: 1rpx; background: #eeedf2; margin: 28rpx 0; }
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.chip { padding: 10rpx 18rpx; border-radius: 14rpx; color: #767e9c; background: #f2f2f8; font-size: 23rpx; }
.chip.active { color: white; background: #6475b9; }
.sticky-actions { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 36rpx calc(20rpx + env(safe-area-inset-bottom)); background: rgba(255,253,249,.98); border-top: 1rpx solid #eceaf0; z-index: 20; }
.with-actions { padding-bottom: calc(170rpx + env(safe-area-inset-bottom)); }
.link { color: #5368b9; }
.nowrap { white-space: nowrap; }
.preserve { white-space: pre-wrap; word-break: break-word; }
