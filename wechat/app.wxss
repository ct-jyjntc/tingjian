/* 听见：奶油黄、纸白与墨黑；语义状态保持独立色彩。 */
page {
  --paper: #f5f5ef;
  --surface: #ffffff;
  --ink: #252b25;
  --muted: #73756a;
  --accent: #252b25;
  --line: #e8e8de;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}
view,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}
button {
  min-height: 44px;
  min-width: 44px;
  margin: 0;
  padding: 22rpx 28rpx;
  border-radius: 20rpx;
  background: #f1f1e8;
  color: var(--accent);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.55;
  transition:
    opacity 0.15s,
    background-color 0.15s;
}
button::after {
  border: 0;
}
/* WeChat style v2 gives regular buttons a fixed width and auto margins. */
.page button:not([size="mini"]),
.sticky-actions button:not([size="mini"]),
.privacy-sheet button:not([size="mini"]) {
  width: auto;
  margin-left: 0;
  margin-right: 0;
}
button[disabled] {
  opacity: 1;
  background: #e9ebe3;
  color: #a1a397;
  box-shadow: none;
}
button[loading] {
  opacity: 0.85;
}
.tap-feedback {
  opacity: 0.7;
}
button:focus-visible {
  outline: 4rpx solid #252b25;
  outline-offset: 5rpx;
}
.page {
  max-width: 960rpx;
  margin: 0 auto;
  padding: 28rpx 32rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
.page-header {
  margin-bottom: 28rpx;
}
.eyebrow {
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}
.page-title {
  font-size: 50rpx;
  line-height: 1.3;
  letter-spacing: -1rpx;
  font-weight: 700;
}
.page-description {
  color: var(--muted);
  font-size: 26rpx;
  margin-top: 14rpx;
}
.section-title {
  font-size: 32rpx;
  line-height: 1.45;
  font-weight: 650;
  margin-bottom: 8rpx;
}
.muted {
  color: var(--muted);
  font-size: 26rpx;
}
.small {
  font-size: 24rpx;
}
.card {
  background: var(--surface);
  border: 1rpx solid transparent;
  border-radius: 32rpx;
  padding: 30rpx;
  margin-top: 24rpx;
}
.primary {
  border-radius: 28rpx;
  background: var(--accent);
  color: #fff;
}
.secondary {
  background: #f1f1e8;
  color: var(--accent);
}
.plain {
  background: transparent;
  color: var(--muted);
  font-weight: 500;
  padding: 20rpx 16rpx;
}
.mini {
  min-height: 44px;
  padding: 20rpx 20rpx;
  font-size: 25rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}
.danger {
  color: #a14141;
  background: #fcf0ee;
}
.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.grow {
  flex: 1;
  min-width: 0;
}
.stack > button {
  margin-top: 16rpx;
}
.badge {
  display: inline-block;
  max-width: 100%;
  padding: 5rpx 14rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--accent);
}
.badge.warm {
  color: #836126;
  background: #fcf2dc;
}
.badge.success {
  color: #28694f;
  background: #e6f0df;
}
.badge.danger {
  color: #a14141;
  background: #fcf0ee;
}
.field-label {
  display: block;
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 500;
  margin: 24rpx 0 10rpx;
}
input,
textarea,
.picker {
  width: 100%;
  background: #fafaf5;
  color: var(--ink);
  border: 2rpx solid #e4e5d9;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
}
input {
  padding-top: 0;
  padding-bottom: 0;
  height: 88rpx;
}
textarea {
  min-height: 180rpx;
  height: 200rpx;
  line-height: 1.65;
}
.field-focus {
  border-color: var(--accent);
  background: #fff;
  box-shadow: 0 0 0 4rpx #fbedad;
}
.input-placeholder,
.textarea-placeholder {
  color: #898c7f;
}
input[disabled],
textarea[disabled] {
  opacity: 0.65;
}
.note {
  background: #fbf3e2;
  color: #7f602b;
  padding: 22rpx 24rpx;
  border: 1rpx solid #eee0c2;
  border-radius: 18rpx;
  font-size: 25rpx;
  margin-top: 20rpx;
  overflow-wrap: anywhere;
}
.note.info {
  color: #626a53;
  background: #f6f3df;
  border-color: #e6e8da;
}
.note.error {
  color: #9b3e3e;
  background: #fcf0ee;
  border-color: #f0d5d1;
}
.note-title {
  font-weight: 650;
  margin-bottom: 6rpx;
}
.empty {
  padding: 48rpx 26rpx;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}
.empty-title {
  color: var(--ink);
  font-size: 31rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.empty-symbol {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0 auto 20rpx;
  background: #f5e4a0;
  color: var(--accent);
  border-radius: 24rpx;
  font-size: 36rpx;
}
.state-panel {
  padding: 36rpx 28rpx;
  text-align: center;
}
.state-panel .plain {
  margin: 12rpx auto 0;
}
.loading-indicator {
  display: inline-block;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #e6e4d7;
  border-top-color: var(--accent);
  border-radius: 50%;
  margin: 0 14rpx -5rpx 0;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.chip {
  min-height: 80rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: var(--accent);
  background: #f1f1e8;
}
.chip.active {
  background: var(--accent);
  color: #fff;
}
.sticky-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 20;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid var(--line);
}
.sticky-inner {
  max-width: 896rpx;
  margin: auto;
}
.with-actions {
  padding-bottom: calc(208rpx + env(safe-area-inset-bottom));
}
.link {
  color: var(--accent);
}
.nowrap {
  white-space: nowrap;
}
.preserve {
  white-space: pre-wrap;
  word-break: break-word;
  overflow-wrap: anywhere;
}
.segmented {
  display: flex;
  gap: 6rpx;
}
.segmented button {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  padding: 18rpx 10rpx;
  min-height: 80rpx;
  background: transparent;
  color: var(--muted);
}
.fold-header {
  width: 100%;
  background: transparent;
  padding: 0;
  text-align: left;
  color: var(--ink);
  font-weight: 400;
}
.fold-header .section-title {
  margin: 0;
}
.fold-summary {
  color: var(--muted);
  font-size: 24rpx;
  margin-top: 6rpx;
  font-weight: 400;
}
.fold-indicator {
  color: var(--accent);
  font-size: 24rpx;
  flex-shrink: 0;
}
.setting-line {
  padding: 22rpx 0;
}
switch {
  flex-shrink: 0;
}
.steps {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  font-size: 22rpx;
  color: var(--muted);
}
.steps .current {
  font-weight: 600;
  color: var(--accent);
}
.step-line {
  height: 1rpx;
  flex: 1;
  background: #e8e8de;
}
@media (max-width: 360px) {
  .page {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }
  .card {
    padding: 24rpx;
  }
  .page-title {
    font-size: 43rpx;
  }
  .small,
  .muted {
    font-size: 28rpx;
  }
  .mini {
    min-height: 104rpx;
  }
  button {
    min-height: 104rpx;
  }
  .segmented button {
    min-height: 104rpx;
  }
  .sticky-actions {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }
}
@media (prefers-reduced-motion: reduce) {
  .loading-indicator {
    animation: none;
  }
  button {
    transition: none;
  }
}

/* Custom navigation overlays tab pages; keep every last row reachable. */
.tab-page {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}
.eyebrow {
  color: #73756a;
}
.page-header .page-title {
  letter-spacing: -1.5rpx;
}
.steps .current {
  background: #f8df78;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
}
.badge {
  border-radius: 12rpx;
  background: #f5e7ac;
}
.segmented {
  background: #eaece1;
  padding: 8rpx;
  border-radius: 24rpx;
}
.segmented .active {
  background: #252b25;
  color: #fbe68c;
  box-shadow: none;
}
.segmented button {
  border-radius: 18rpx;
}
.card {
  box-shadow: 0 6rpx 24rpx rgba(40, 46, 30, 0.025);
}
.ui-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
