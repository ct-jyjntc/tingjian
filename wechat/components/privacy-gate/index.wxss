.privacy-mask {
  position: fixed;
  inset: 0;
  background: rgba(24, 35, 53, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.privacy-sheet {
  background: #fff;
  padding: 40rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  box-sizing: border-box;
}
.privacy-link {
  min-height: 88rpx;
  padding: 24rpx 0;
  color: #252b25;
  font-size: 27rpx;
}
