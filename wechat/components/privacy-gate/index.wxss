.privacy-mask { position: fixed; inset: 0; background: rgba(35, 40, 61, .42); z-index: 1000; display: flex; align-items: flex-end; }
.privacy-sheet { background: #fffdf9; padding: 48rpx 40rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius: 40rpx 40rpx 0 0; width: 100%; box-sizing: border-box; }
.privacy-link { padding: 32rpx 0; color: #5368b9; }
