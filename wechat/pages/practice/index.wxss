.progress-label { margin-bottom: 16rpx; }.listen-card { margin-top: 34rpx; padding: 48rpx 30rpx 38rpx; text-align: center; background: #eff1fb; border-radius: 34rpx; min-height: 390rpx; }.listening-symbol { height: 112rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; margin: 8rpx 0 30rpx; }.listening-symbol view { width: 11rpx; height: 28rpx; border-radius: 10rpx; background: #9aa8d4; }.listening-symbol view:nth-child(2), .listening-symbol view:nth-child(4) { height: 56rpx; }.listening-symbol view:nth-child(3) { height: 82rpx; }.is-playing .listening-symbol view { animation: listening 1s ease-in-out infinite alternate; }.is-playing .listening-symbol view:nth-child(2) { animation-delay: -.4s; }.is-playing .listening-symbol view:nth-child(3) { animation-delay: -.2s; }.is-playing .listening-symbol view:nth-child(4) { animation-delay: -.6s; }@keyframes listening { from { transform: scaleY(.55); } to { transform: scaleY(1.1); } }.listen-title { font-size: 40rpx; font-weight: 650; }.listen-subtitle { color: #8b93b0; margin-top: 14rpx; font-size: 24rpx; }.revealed-answer { font-size: 40rpx; padding: 24rpx 12rpx 8rpx; color: #5368b9; word-break: break-word; }.primary-controls { margin-top: 26rpx; }.quick-controls { display: flex; gap: 12rpx; margin-top: 18rpx; }.quick-controls button { flex: 1; padding: 20rpx 6rpx; font-size: 24rpx; font-weight: 500; }.hint-actions { display: flex; justify-content: center; margin-top: 12rpx; }.conversation { margin-top: 32rpx; padding: 28rpx; }.narration-setting { margin-top: 18rpx; padding-bottom: 12rpx; border-bottom: 1rpx solid #eeeef4; }.turn { padding: 24rpx; border-radius: 20rpx; margin-top: 24rpx; font-size: 27rpx; }.turn.user { margin-left: 45rpx; background: #eef0fa; }.turn.assistant { margin-right: 14rpx; background: #f6f5f1; }.turn-role { font-size: 20rpx; color: #9095a8; margin-bottom: 12rpx; }.explanation-title { font-weight: 650; font-size: 31rpx; margin-bottom: 12rpx; }.explanation-section { margin-top: 24rpx; padding-top: 18rpx; border-top: 1rpx solid #e7e5de; }.section-label { color: #7f8864; font-weight: 600; margin-bottom: 8rpx; }.speak-button { padding-left: 0; padding-bottom: 0; text-align: left; }.feedback { font-size: 24rpx; color: #8a89a5; margin-top: 22rpx; }.composer { margin-top: 26rpx; }.composer input { height: 80rpx; font-size: 25rpx; }.voice-button { font-size: 25rpx; font-weight: 500; margin-top: 18rpx; background: #f1f2f7; color: #727eaa; }.voice-button.recording { background: #6376b9; color: white; }.ai-note { margin-top: 20rpx; text-align: center; font-size: 20rpx; }
