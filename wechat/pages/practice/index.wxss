.progress-label {
  margin-bottom: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.listen-card {
  margin-top: 28rpx;
  text-align: center;
}
.listening-symbol {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 24rpx 0;
}
.listening-symbol view {
  width: 10rpx;
  height: 24rpx;
  border-radius: 8rpx;
  background: #30392d;
}
.listening-symbol view:nth-child(2),
.listening-symbol view:nth-child(4) {
  height: 48rpx;
}
.listening-symbol view:nth-child(3) {
  height: 72rpx;
}
.is-playing .listening-symbol view {
  animation: listening 1s ease-in-out infinite alternate;
}
.is-playing .listening-symbol view:nth-child(2) {
  animation-delay: -0.4s;
}
.is-playing .listening-symbol view:nth-child(3) {
  animation-delay: -0.2s;
}
.is-playing .listening-symbol view:nth-child(4) {
  animation-delay: -0.6s;
}
@keyframes listening {
  from {
    transform: scaleY(0.55);
  }
  to {
    transform: scaleY(1.1);
  }
}
.listen-subtitle {
  color: #65695e;
  font-size: 26rpx;
}
.revealed-answer {
  font-size: 38rpx;
  padding: 24rpx 12rpx 8rpx;
  color: #252b25;
  overflow-wrap: anywhere;
}
.primary-controls {
  margin-top: 24rpx;
}
.primary-controls button {
  padding: 28rpx 20rpx;
  font-size: 31rpx;
}
.quick-controls {
  display: grid;
  margin-top: 16rpx;
}
.quick-controls button {
  min-width: 0;
  font-weight: 500;
  background: #fff;
  border: 1rpx solid #e8e8de;
}
.return-button {
  margin-top: 24rpx;
}
@media (prefers-reduced-motion: reduce) {
  .is-playing .listening-symbol view {
    animation: none;
  }
}

.listen-card {
  background: #e9eddf;
  border: 0;
  border-radius: 36rpx;
  padding: 28rpx 28rpx 34rpx;
  overflow: hidden;
}
.listen-card .eyebrow {
  letter-spacing: 1rpx;
  color: #647152;
}
.record-player {
  position: relative;
  width: 268rpx;
  height: 268rpx;
  margin: 24rpx auto 26rpx;
  border-radius: 50%;
  background: #30392d;
  box-shadow: 0 12rpx 28rpx #394d2420;
  display: flex;
  align-items: center;
  justify-content: center;
}
.record-ring {
  position: absolute;
  border: 2rpx solid #58604c;
  border-radius: 50%;
  opacity: 0.6;
}
.ring-one {
  inset: 16rpx;
}
.ring-two {
  inset: 30rpx;
}
.ring-three {
  inset: 44rpx;
}
.record-player .listening-symbol {
  position: relative;
  background: #f8dc70;
  width: 144rpx;
  height: 144rpx;
  margin: 0;
  border-radius: 50%;
  gap: 8rpx;
}
.record-player .listening-symbol view {
  width: 7rpx;
  background: #30392d;
  height: 20rpx;
}
.record-player .listening-symbol view:nth-child(2),
.record-player .listening-symbol view:nth-child(4) {
  height: 38rpx;
}
.record-player .listening-symbol view:nth-child(3) {
  height: 54rpx;
}
.listen-title {
  font-size: 45rpx;
  font-weight: 700;
}
.listen-subtitle {
  margin-top: 10rpx;
}
.primary-controls button {
  border-radius: 60rpx;
  background: #252b25;
  color: #fbe99d;
}
.quick-controls {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
}
.quick-controls button {
  padding: 22rpx 4rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
}
@media (max-width: 360px) {
  .quick-controls {
    grid-template-columns: 1fr 1fr;
  }
}
.practice {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}
.practice .record-player {
  width: 228rpx !important;
  min-width: 228rpx;
  height: 228rpx;
  min-height: 228rpx;
  margin: 18rpx auto 24rpx !important;
  padding: 0;
}
.record-player .listening-symbol {
  width: 126rpx;
  height: 126rpx;
}
.listen-card {
  margin-top: 20rpx;
  padding: 24rpx 24rpx 30rpx;
}
.listen-title {
  font-size: 40rpx;
}
.quick-controls {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}
.quick-controls .marked-control {
  color: #556b3b;
  background: #e1ead4;
  border-color: #b4c798;
}
.practice-dock .primary-controls {
  display: flex;
  gap: 16rpx;
  margin-top: 0;
  align-items: stretch;
}
.practice-dock .primary-controls button {
  margin: 0;
  padding: 24rpx 16rpx;
  border-radius: 28rpx;
  font-size: 28rpx;
}
.practice-dock .replay-control {
  width: 200rpx !important;
  min-width: 0;
  flex-shrink: 0;
  background: #f2f1e6;
  color: #252b25;
  font-size: 26rpx !important;
}
.practice-dock .primary[disabled] {
  background: #e9ebe3;
  color: #898c7f;
}
@media (max-width: 360px) {
  .practice-dock .replay-control {
    width: 174rpx !important;
  }
  .practice-dock .primary-controls button {
    font-size: 27rpx;
  }
  .practice .record-player {
    width: 208rpx !important;
    min-width: 208rpx;
    height: 208rpx;
    min-height: 208rpx;
  }
  .listen-title {
    font-size: 38rpx;
  }
}

@media (max-width: 360px) {
  .quick-controls button,
  .listen-subtitle,
  .voice-control .mini {
    font-size: 28rpx;
  }
}

.voice-control {
  margin-top: 24rpx;
  padding: 24rpx 26rpx;
}
.voice-control .section-title {
  margin: 0;
  font-size: 30rpx;
}
.mic-indicator {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  background: #edeedf;
  border-radius: 18rpx;
  flex-shrink: 0;
}
.mic-indicator view {
  width: 5rpx;
  height: 15rpx;
  border-radius: 4rpx;
  background: #8c9380;
}
.mic-indicator view:nth-child(2) {
  height: 28rpx;
}
.mic-indicator.is-listening {
  background: #f8df78;
}
.is-listening view {
  background: #394d30;
  animation: listening 0.9s ease-in-out infinite alternate;
}
.is-listening view:nth-child(2) {
  animation-delay: -0.3s;
}
.voice-status {
  margin-top: 14rpx;
  font-size: 27rpx;
  color: #556247;
}
.voice-examples {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-top: 18rpx;
}
.voice-examples text {
  background: #f5f4ea;
  color: #747363;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}
.voice-receipt {
  padding: 16rpx 18rpx;
  margin-top: 18rpx;
  background: #f5f2df;
  border-radius: 16rpx;
  font-size: 26rpx;
  overflow-wrap: anywhere;
}
.voice-help-toggle {
  margin-top: 6rpx;
  padding-left: 0;
  text-align: left;
}
.voice-help {
  line-height: 1.8;
}
@media (prefers-reduced-motion: reduce) {
  .is-listening view {
    animation: none;
  }
}
@media (max-width: 360px) {
  .voice-status,
  .voice-help,
  .voice-examples text {
    font-size: 28rpx;
  }
}
