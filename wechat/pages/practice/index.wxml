<view class="page practice">
  <view wx:if="{{loading}}" class="empty">正在准备你的练习…</view>
  <block wx:else>
    <view class="between progress-label"><view>本次听写 <text class="muted">{{index}} / {{total}}</text></view><button class="plain mini" data-intent="end" bindtap="tapAction" disabled="{{phase === 'completed'}}">结束</button></view>
    <progress percent="{{progress}}" stroke-width="4" activeColor="#8895c8" backgroundColor="#e9eaf1" border-radius="4"/>
    <view class="listen-card {{phase === 'playing' ? 'is-playing' : ''}}">
      <view class="eyebrow">第 {{index}} 项 · {{speed}} 倍速</view>
      <view class="listening-symbol"><view></view><view></view><view></view><view></view><view></view></view>
      <view class="listen-title">{{label}}</view>
      <view class="listen-subtitle">{{phase === 'waiting' ? '写好了再继续，我会一直等你。' : phase === 'playing' ? '不用赶时间，声音结束后再慢慢写。' : '准备好后，点一下继续。'}}</view>
      <view wx:if="{{answer}}" class="revealed-answer">{{answer}}</view>
      <view wx:if="{{marked}}" class="badge warm">已标记 · 这项再练练</view>
      <view wx:if="{{error}}" class="note error">{{error}}</view>
    </view>
    <view class="primary-controls">
      <button wx:if="{{phase === 'waiting'}}" class="primary" data-intent="next" bindtap="tapAction">{{index === total ? '写好了，完成听写 ✓' : '写好了，下一项 →'}}</button>
      <button wx:elif="{{phase === 'playing' || phase === 'preparing'}}" class="primary" data-intent="pause" bindtap="tapAction">暂停一下</button>
      <button wx:elif="{{phase === 'completed'}}" class="primary" bindtap="finishRetry">查看听写结果</button>
      <button wx:else class="primary" data-intent="resume" bindtap="tapAction" disabled="{{!total || phase === 'confirming'}}">{{phase === 'error' ? '重试当前项' : '继续听写'}}</button>
    </view>
    <view class="quick-controls"><button data-intent="previous" bindtap="tapAction" disabled="{{index <= 1 || phase === 'completed'}}">上一项</button><button data-intent="repeat" bindtap="tapAction" disabled="{{phase === 'completed'}}">再读一遍</button><button data-intent="slower" bindtap="tapAction" disabled="{{phase === 'completed'}}">慢一点</button><button data-intent="mark" bindtap="tapAction" disabled="{{marked || phase === 'completed'}}">标记不会</button></view>
    <view wx:if="{{allowHints}}" class="hint-actions"><button class="plain mini" data-intent="explain" bindtap="tapAction" disabled="{{assistantBusy || phase === 'completed'}}">给我一点提示</button><button class="plain mini" bindtap="reveal">{{revealed ? '收起答案' : '看一眼答案'}}</button></view>
    <view wx:if="{{syncError}}" class="note error">{{syncError}}<button class="plain mini" bindtap="sync">重试同步</button></view>
    <view class="card conversation">
      <view class="between"><view class="section-title">✧ 听见在这里</view><view class="badge">听写搭档</view></view>
      <view class="muted">可以说“我没听清”，也可以聊聊怎么记住它。</view>
      <view class="between narration-setting"><text class="small muted">自动朗读讲解与回复</text><switch color="#6376b9" checked="{{autoSpeak}}" bindchange="autoSpeak"/></view>
      <view wx:for="{{turns}}" wx:key="id" class="turn {{item.role}}">
        <view class="turn-role">{{item.role === 'user' ? '我' : '听见 · AI'}}</view>
        <block wx:if="{{item.explanation}}"><view class="explanation-title">{{item.explanation.title}}</view><view class="preserve">{{item.explanation.summary}}</view><view wx:for="{{item.explanation.sections}}" wx:for-item="section" wx:key="index" class="explanation-section"><view class="section-label">{{section.label}}</view><view class="preserve">{{section.text}}</view></view></block>
        <view wx:else class="preserve">{{item.text}}</view>
        <button wx:if="{{item.role === 'assistant' && speakingId !== item.id}}" class="plain mini speak-button" data-id="{{item.id}}" bindtap="speakTurn">朗读这段话</button>
        <button wx:if="{{speakingId === item.id}}" class="plain mini speak-button" bindtap="stopNarration">停止朗读 ■</button>
      </view>
      <view wx:if="{{feedback}}" class="feedback preserve">{{feedback}}</view>
      <view class="row composer"><input class="grow" value="{{input}}" bindinput="input" bindconfirm="send" maxlength="3000" confirm-type="send" placeholder="想问什么，直接告诉我" disabled="{{assistantBusy || recordBusy || phase === 'completed'}}"/><button class="mini" bindtap="send" disabled="{{!input || assistantBusy || recordBusy || phase === 'completed'}}">发送</button></view>
      <button class="voice-button {{recording ? 'recording' : ''}}" bindtap="voice" disabled="{{phase === 'completed' || (recordBusy && !recording)}}">{{recording ? '说完了，发送录音 ↑' : recordBusy ? '正在转写…' : '用语音和我说'}}</button>
      <button wx:if="{{assistantBusy}}" class="plain mini" bindtap="cancelAssistant">取消这次提问</button>
      <view class="small muted ai-note">AI 的解释可能有误，记得对照课本核查。</view>
    </view>
  </block>
</view>
<privacy-gate/>
