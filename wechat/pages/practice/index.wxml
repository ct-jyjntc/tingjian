<view class="page with-actions practice">
  <view wx:if="{{loading}}" class="card state-panel"
    ><view class="loading-indicator"></view
    ><text class="muted">正在准备你的练习…</text></view
  >
  <view wx:elif="{{!total}}" class="card empty"
    ><view class="empty-title">暂时无法开始听写</view
    ><view class="preserve">{{error}}</view
    ><button
      hover-class="tap-feedback"
      hover-stay-time="80"
      class="primary return-button"
      bindtap="home"
    >
      返回准备清单
    </button></view
  ><block wx:else>
    <view class="between progress-label"
      ><view>本次听写 <text class="muted">{{index}} / {{total}}</text></view
      ><button
        hover-class="tap-feedback"
        hover-stay-time="80"
        class="plain mini"
        data-intent="end"
        bindtap="tapAction"
        disabled="{{phase === 'completed'}}"
      >
        结束
      </button></view
    >
    <progress
      percent="{{progress}}"
      stroke-width="4"
      activeColor="#252b25"
      backgroundColor="#e1e4d5"
      border-radius="4"
    />
    <view class="listen-card {{phase === 'playing' ? 'is-playing' : ''}}">
      <view class="eyebrow">第 {{index}} 项 · {{speed}} 倍速</view
      ><view wx:if="{{phase === 'preparing'}}" class="loading-indicator"></view>
      <button
        class="record-player"
        bindtap="togglePlayback"
        hover-class="tap-feedback"
        disabled="{{phase === 'completed' || phase === 'confirming'}}"
        aria-label="{{phase === 'playing' || phase === 'preparing' ? '暂停朗读' : phase === 'waiting' ? '重听当前项' : '开始朗读当前项'}}"
      >
        <view class="record-ring ring-one"></view
        ><view class="record-ring ring-two"></view
        ><view class="record-ring ring-three"></view
        ><view class="listening-symbol"
          ><view></view><view></view><view></view><view></view><view></view
        ></view></button
      ><view class="listen-title">{{label}}</view>
      <view class="listen-subtitle"
        >{{phase === 'waiting' ? '写好了再继续，我会一直等你。' : phase ===
        'playing' ? '先听清楚，再慢慢写。' : phase === 'preparing' ?
        '正在获取朗读音频，请稍候。' : phase === 'completed' ?
        '进度已保留，接下来核查答案。' : phase === 'error' ?
        '检查网络后，可以重试当前项。' : voiceEnabled ?
        '准备好后，说“开始”或点继续。' : '准备好后，点一下继续。'}}</view
      >
      <view wx:if="{{answer}}" class="revealed-answer">{{answer}}</view>
      <view wx:if="{{marked}}" class="badge warm">已标记 · 这项再练练</view>
      <view wx:if="{{error}}" class="note error">{{error}}</view>
    </view>
    <view class="quick-controls"
      ><button
        hover-class="tap-feedback"
        hover-stay-time="80"
        data-intent="previous"
        bindtap="tapAction"
        disabled="{{index <= 1 || phase === 'completed'}}"
      >
        上一项</button
      ><button
        hover-class="tap-feedback"
        hover-stay-time="80"
        data-intent="slower"
        bindtap="tapAction"
        disabled="{{phase === 'completed' || speed <= 0.5}}"
      >
        慢一点</button
      ><button
        hover-class="tap-feedback"
        hover-stay-time="80"
        data-intent="mark"
        bindtap="tapAction"
        disabled="{{phase === 'completed'}}"
        aria-pressed="{{marked}}"
        class="{{marked ? 'marked-control' : ''}}"
      >
        {{marked ? '已标记 · 取消' : '标记不会'}}
      </button></view
    >
    <view wx:if="{{syncError}}" class="note error"
      >{{syncError}}<button
        hover-class="tap-feedback"
        hover-stay-time="80"
        class="plain mini"
        bindtap="sync"
      >
        重试同步
      </button></view
    >
    <view class="card voice-control">
      <view class="between">
        <view class="row grow"
          ><view
            class="mic-indicator {{micState === 'listening' || micState === 'speech' ? 'is-listening' : ''}}"
            aria-hidden="true"
            ><view></view><view></view><view></view></view
          ><view class="section-title">语音控制</view></view
        >
        <switch
          checked="{{voiceEnabled}}"
          bindchange="voiceToggle"
          color="#252b25"
          disabled="{{phase === 'completed'}}"
          aria-label="持续聆听语音指令"
        />
      </view>
      <view class="voice-status" aria-live="polite"
        >{{micState === 'starting' ? '正在开启麦克风…' : micState === 'speech' ?
        '听到你了，说完会自动处理' : micState === 'processing' ?
        '正在识别你说的话…' : micState === 'listening' ?
        '正在听，你可以直接说话' : micState === 'muted' ? (phase ===
        'confirming' ? '确认结束期间暂不识别' : '正在朗读，读完自动接着听') :
        micState === 'error' ? '语音暂不可用，按钮仍可使用' :
        '语音已关闭，可用下方按钮操作'}}</view
      >
      <view wx:if="{{voiceEnabled}}" class="voice-examples"
        ><text>“写好了”</text><text>“再读一遍”</text><text>“慢一点”</text></view
      >
      <view wx:if="{{heard}}" class="voice-receipt"
        ><view class="small muted">听到：{{heard}}</view
        ><view>{{voiceFeedback || '正在理解这句话…'}}</view></view
      >
      <view wx:if="{{voiceError}}" class="note error"
        ><view>{{voiceError}}</view
        ><view class="row"
          ><button
            class="mini plain"
            bindtap="retryListening"
            hover-class="tap-feedback"
          >
            重新开启</button
          ><button
            class="mini plain"
            bindtap="permissions"
            hover-class="tap-feedback"
          >
            录音权限设置
          </button></view
        ></view
      >
      <button
        class="plain mini voice-help-toggle"
        bindtap="voiceHelp"
        aria-expanded="{{showVoiceHelp}}"
        hover-class="tap-feedback"
      >
        {{showVoiceHelp ? '收起说明 −' : '还可以怎么说 ＋'}}
      </button>
      <view wx:if="{{showVoiceHelp}}" class="voice-help small muted"
        >“等一下”“继续”“上一个”“快一点”“标记不会”“结束听写”也可以。开启后不用逐句按录音键，说完停顿一下即可。朗读时不识别语音，避免误听题目；离开听写页会停止录音。</view
      >
    </view>
  </block>
</view>
<view wx:if="{{total && !loading}}" class="sticky-actions practice-dock"
  ><view class="sticky-inner primary-controls"
    ><button
      class="secondary replay-control"
      hover-class="tap-feedback"
      data-intent="repeat"
      bindtap="tapAction"
      disabled="{{phase === 'completed' || phase === 'confirming'}}"
    >
      再读一遍
    </button>
    <button
      hover-class="tap-feedback"
      hover-stay-time="80"
      wx:if="{{phase === 'waiting'}}"
      class="primary grow"
      data-intent="next"
      bindtap="tapAction"
    >
      {{index === total ? '写好了，完成听写 ✓' : '写好了，下一项 →'}}
    </button>
    <button
      hover-class="tap-feedback"
      hover-stay-time="80"
      wx:elif="{{phase === 'playing' || phase === 'preparing'}}"
      class="primary grow"
      data-intent="pause"
      bindtap="tapAction"
    >
      暂停一下
    </button>
    <button
      hover-class="tap-feedback"
      hover-stay-time="80"
      wx:elif="{{phase === 'completed'}}"
      class="primary grow"
      bindtap="finishRetry"
      loading="{{finishing}}"
      disabled="{{finishing}}"
    >
      {{finishing ? '正在保存…' : '查看听写结果'}}
    </button>
    <button
      hover-class="tap-feedback"
      hover-stay-time="80"
      wx:else
      class="primary grow"
      data-intent="resume"
      bindtap="tapAction"
      disabled="{{!total || phase === 'confirming'}}"
    >
      {{phase === 'error' ? '重试当前项' : '继续听写'}}
    </button>
  </view>
</view>
<privacy-gate />
