.result-overview { background: #f0f1fb; border-radius: 30rpx; padding: 38rpx 32rpx; margin-top: 32rpx; display: flex; align-items: center; gap: 28rpx; }.big-score { font-size: 62rpx; font-weight: 650; color: #6779ba; line-height: 1.3; }.overview-detail { font-size: 23rpx; color: #8b92a9; line-height: 2; border-left: 1rpx solid #dcdfef; padding-left: 25rpx; }.answer-photo { width: 100%; height: 350rpx; background: #f3f2f6; border-radius: 18rpx; margin-top: 22rpx; }.photo-submit { margin-top: 20rpx; }.grading-rules { padding: 16rpx 20rpx 0; }.grading-rules .between { padding-top: 14rpx; }.result-number { font-size: 23rpx; color: #9399af; }.expected { font-size: 38rpx; font-weight: 600; margin-top: 16rpx; word-break: break-word; }.reason { font-size: 23rpx; color: #9a9588; margin-top: 18rpx; }.confirmation { display: flex; align-items: center; font-size: 25rpx; color: #788095; margin-top: 22rpx; }.confirmation checkbox { transform: scale(.82); transform-origin: left center; }.again { margin-top: 28rpx; }
