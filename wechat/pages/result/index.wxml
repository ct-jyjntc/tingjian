<view class="page with-actions result">
  <view class="steps"
    ><text>01 准备</text><view class="step-line"></view><text>02 听写</text
    ><view class="step-line"></view
    ><text class="current">03 核查答案</text></view
  ><view class="page-header"
    ><view class="page-title">核对这次的答案</view
    ><view class="page-description"
      >识别只是建议，你的确认才计入结果。</view
    ></view
  >
  <view wx:if="{{loading}}" class="card state-panel"
    ><view class="loading-indicator"></view
    ><text class="muted">正在读取听写记录…</text></view
  ><view wx:if="{{error}}" class="note error"
    ><view>{{error}}</view
    ><button
      hover-class="tap-feedback"
      hover-stay-time="80"
      wx:if="{{!total}}"
      class="plain mini"
      bindtap="retryLoad"
    >
      重新加载
    </button></view
  >
  <block wx:if="{{!loading && total}}">
    <view class="result-overview"
      ><view class="result-star" aria-hidden="true">✦</view
      ><view class="between"
        ><view
          ><view class="score-caption"
            >{{confirmed ? '已核查正确率' : '等待核查'}}</view
          ><view class="big-score">{{accuracy}}</view></view
        ><view class="overview-detail"
          ><view>听写 {{written}} / {{total}} 项</view
          ><view>已核查 {{confirmed}} · 正确 {{correct}}</view></view
        ></view
      ><view class="review-progress"
        ><progress
          percent="{{total ? confirmed / total * 100 : 0}}"
          stroke-width="4"
          activeColor="#252b25"
          backgroundColor="#e7dfbb"
          border-radius="4"
        /><view class="small"
          >{{confirmed === total ? '全部核查完成，可以保存了' : '还有 ' + (total
          - confirmed) + ' 项待核查'}}</view
        ></view
      ></view
    >
    <view class="card"
      ><view class="between"
        ><view class="section-title">照片识别</view
        ><button
          hover-class="tap-feedback"
          hover-stay-time="80"
          class="mini"
          bindtap="choose"
          disabled="{{busy}}"
        >
          添加答案照片
        </button></view
      ><view class="muted"
        >也可以直接在下方填写答案。无法辨认的内容不算错。</view
      ><image
        wx:if="{{photo}}"
        class="answer-photo"
        src="{{photo}}"
        mode="aspectFit"
        bindtap="preview"
      /><button
        hover-class="tap-feedback"
        hover-stay-time="80"
        wx:if="{{photo}}"
        class="primary photo-submit"
        bindtap="recognize"
        disabled="{{busy}}"
        loading="{{recognizing}}"
      >
        {{recognizing ? '正在识别与核对…' : '识别这张答案'}}
      </button></view
    >
    <view wx:if="{{message}}" class="note">{{message}}</view
    ><button
      hover-class="tap-feedback"
      hover-stay-time="80"
      wx:if="{{recognizing}}"
      class="plain"
      bindtap="cancel"
    >
      取消 AI 识别
    </button>
    <view class="card grading-rules"
      ><button
        hover-class="tap-feedback"
        hover-stay-time="80"
        class="fold-header between"
        bindtap="toggleRules"
        aria-expanded="{{showRules}}"
      >
        <view
          ><view class="section-title">核查规则</view
          ><view class="fold-summary"
            >{{caseSensitive ? '区分大小写' : '忽略大小写'}} · {{punctuation ?
            '严格比较标点' : '忽略标点差异'}}</view
          ></view
        ><text class="fold-indicator"
          >{{showRules ? '收起 −' : '调整 ＋'}}</text
        ></button
      ><view hidden="{{!showRules}}"
        ><view class="between"
          ><text class="small muted">区分大小写</text
          ><switch
            checked="{{caseSensitive}}"
            color="#252b25"
            data-rule="caseSensitive"
            bindchange="rules"
            disabled="{{busy}}" /></view
        ><view class="between"
          ><text class="small muted">严格比较标点</text
          ><switch
            checked="{{punctuation}}"
            color="#252b25"
            data-rule="punctuation"
            bindchange="rules"
            disabled="{{busy}}" /></view></view
    ></view>
    <view class="note info"
      >逐项核对文字与题号，再勾选“已核查”。只有确认的错误或漏写会进入错词本。</view
    >
    <view
      wx:for="{{rows}}"
      wx:key="id"
      class="card result-item {{item.confirmed ? (item.status === '正确' ? 'is-correct' : 'needs-practice') : 'unconfirmed'}}"
    >
      <view class="between"
        ><view class="result-number">第 {{item.number}} 项</view
        ><view
          class="badge {{!item.confirmed ? 'warm' : item.status === '正确' ? 'success' : 'danger'}}"
          >{{item.confirmed ? item.status : '待核查 · ' + item.status}}</view
        ></view
      >
      <view class="field-label">标准答案</view
      ><view class="expected">{{item.answer}}</view
      ><view wx:if="{{item.spoken !== item.answer}}" class="small muted"
        >朗读提示：{{item.spoken}}</view
      >
      <view class="field-label">你写下的答案</view
      ><input
        class="{{focusKey === 'answer-' + index ? 'field-focus' : ''}}"
        value="{{item.recognized}}"
        data-index="{{index}}"
        bindinput="edit"
        maxlength="4000"
        placeholder="手动填写或修正识别文字"
        disabled="{{busy}}"
        data-focus-key="answer-{{index}}"
        bindfocus="focusField"
        aria-label="你写下的答案"
        bindblur="blurField"
        cursor-spacing="40"
      />
      <view class="reason">{{item.reason}}</view
      ><checkbox-group data-index="{{index}}" bindchange="check"
        ><label class="confirmation"
          ><checkbox
            value="confirmed"
            checked="{{item.confirmed}}"
            color="#252b25"
            disabled="{{busy}}"
          />已核查文字与题号</label
        ></checkbox-group
      >
    </view>
    <view wx:if="{{pending}}" class="note"
      ><view>核查修改已留在本机，点击下方按钮同步。</view
      ><button
        hover-class="tap-feedback"
        hover-stay-time="80"
        class="plain mini"
        bindtap="reloadCloud"
      >
        发生冲突时，载入云端版本
      </button></view
    >
    <button
      hover-class="tap-feedback"
      hover-stay-time="80"
      class="secondary again"
      bindtap="practiceAgain"
      disabled="{{!wrong || busy}}"
    >
      把确认的错词再练一遍</button
    ><button
      hover-class="tap-feedback"
      hover-stay-time="80"
      class="plain"
      bindtap="home"
    >
      回到首页
    </button>
  </block>
</view>
<view class="sticky-actions"
  ><view class="sticky-inner"
    ><button
      hover-class="tap-feedback"
      hover-stay-time="80"
      class="primary save-results"
      bindtap="save"
      disabled="{{loading || busy || !total}}"
      loading="{{saving}}"
    >
      {{saving ? '正在保存…' : '保存核查结果 · ' + confirmed + ' 项'}}
    </button></view
  ></view
>
<privacy-gate />
