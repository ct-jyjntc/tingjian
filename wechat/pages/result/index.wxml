<view class="page with-actions result {{undoLabel ? 'with-undo' : ''}}">
  <view class="page-header"
    ><view class="eyebrow">最后一步 · 核对答案</view
    ><view class="page-title">核对这次听写</view
    ><view class="page-description"
      >对照纸上的答案，按自己的节奏核对。</view
    ></view
  >
  <view wx:if="{{loading}}" class="card state-panel"
    ><view class="loading-indicator"></view>正在读取听写记录…</view
  >
  <view wx:if="{{error}}" class="note error"
    ><view>{{error}}</view
    ><button
      wx:if="{{!total}}"
      class="plain mini"
      hover-class="tap-feedback"
      bindtap="retryLoad"
    >
      重新加载
    </button></view
  >
  <block wx:if="{{!loading && total}}">
    <view class="result-overview"
      ><view class="result-star" aria-hidden="true">✦</view
      ><view class="between"
        ><view
          ><view class="score-caption"
            >{{confirmed ? '已核对部分的正确率' : '等你核对'}}</view
          ><view class="big-score">{{accuracy}}</view></view
        ><view class="overview-detail"
          ><view class="review-count"
            >{{confirmed}}<text> / {{total}} 项</text></view
          ><view>正确 {{correct}} · 需复习 {{wrong}}</view></view
        ></view
      ><view class="review-progress"
        ><progress
          percent="{{confirmed / total * 100}}"
          stroke-width="4"
          activeColor="#252b25"
          backgroundColor="#e7dfbb"
          border-radius="4"
        /><view class="small"
          >{{remaining ? '还有 ' + remaining + ' 项没有核对' : pending ?
          '全部核对好了，保存后就完成了' : '核查结果已保存'}}</view
        ></view
      ></view
    >
    <view class="photo-review {{photo ? 'has-photo' : ''}}"
      ><view class="between"
        ><view class="grow"
          ><view class="section-title">用照片辅助核查</view
          ><view class="small muted">可选 · 识别后由你确认</view></view
        ><button
          class="mini"
          bindtap="choose"
          disabled="{{busy}}"
          hover-class="tap-feedback"
        >
          <image class="ui-icon" src="/assets/camera-active.png" /><text
            >{{photo ? '换照片' : '选照片'}}</text
          >
        </button></view
      ><image
        wx:if="{{photo}}"
        class="answer-photo"
        src="{{photo}}"
        mode="aspectFit"
        bindtap="preview"
      /><button
        wx:if="{{photo}}"
        class="primary photo-submit"
        bindtap="recognize"
        disabled="{{busy}}"
        loading="{{recognizing}}"
        hover-class="tap-feedback"
      >
        {{recognizing ? '正在识别…' : '识别这张答案'}}</button
      ><button wx:if="{{recognizing}}" class="plain mini" bindtap="cancel">
        取消识别
      </button></view
    >
    <view wx:if="{{taskError}}" class="note error">{{taskError}}</view
    ><view wx:if="{{message}}" class="note info">{{message}}</view>
    <view id="review-list" class="review-toolbar"
      ><view class="between review-heading">
        <view class="section-title">答案清单</view>
        <button
          class="plain mini"
          bindtap="toggleRules"
          aria-expanded="{{showRules}}"
          hover-class="tap-feedback"
        >
          核查规则 {{showRules ? '−' : '＋'}}
        </button>
      </view>
      <view class="segmented"
        ><button
          data-filter="pending"
          bindtap="filter"
          aria-pressed="{{reviewFilter === 'pending'}}"
          class="{{reviewFilter === 'pending' ? 'active' : ''}}"
          hover-class="tap-feedback"
        >
          未核对 {{remaining}}</button
        ><button
          data-filter="wrong"
          bindtap="filter"
          aria-pressed="{{reviewFilter === 'wrong'}}"
          class="{{reviewFilter === 'wrong' ? 'active' : ''}}"
          hover-class="tap-feedback"
        >
          需复习 {{wrong}}</button
        ><button
          data-filter="all"
          bindtap="filter"
          aria-pressed="{{reviewFilter === 'all'}}"
          class="{{reviewFilter === 'all' ? 'active' : ''}}"
          hover-class="tap-feedback"
        >
          全部 {{total}}
        </button></view
      ></view
    >
    <view wx:if="{{candidateCorrect}}" class="batch-review">
      <view class="small muted">{{candidateCorrect}} 项识别文字与答案一致</view>
      <button
        class="plain mini"
        bindtap="confirmCorrect"
        disabled="{{busy}}"
        hover-class="tap-feedback"
      >
        核对后批量确认 →
      </button>
    </view>
    <view wx:if="{{showRules}}" class="card grading-rules"
      ><view class="between"
        ><text>区分大小写</text
        ><switch
          checked="{{caseSensitive}}"
          color="#252b25"
          data-rule="caseSensitive"
          bindchange="rules"
          disabled="{{busy}}" /></view
      ><view class="between"
        ><text>严格比较标点</text
        ><switch
          checked="{{punctuation}}"
          color="#252b25"
          data-rule="punctuation"
          bindchange="rules"
          disabled="{{busy}}" /></view
      ><view class="small muted"
        >规则影响文字比对；已对照纸面标记的对错保留。</view
      ></view
    >
    <view wx:if="{{!rows.length}}" class="card empty"
      ><view class="empty-symbol">✓</view
      ><view class="empty-title"
        >{{reviewFilter === 'pending' ? '这一轮核对完了' :
        '暂时没有需要复习的词'}}</view
      ><view>可以切到“全部”回看每一项。</view
      ><button class="plain mini" data-filter="all" bindtap="filter">
        查看全部答案
      </button></view
    >
    <view wx:if="{{rows.length}}" class="answer-sheet">
      <view class="sheet-heading"
        ><text>题号 · 标准答案</text><text>核查结果</text></view
      >
      <view
        wx:for="{{rows}}"
        wx:key="id"
        id="result-{{item.number}}"
        class="result-item {{item.confirmed ? (item.status === '正确' ? 'is-correct' : 'needs-practice') : 'unconfirmed'}} {{editingIndex === item.number - 1 ? 'is-editing' : ''}}"
      >
        <view class="result-main">
          <view class="result-number" aria-label="第 {{item.number}} 项"
            >{{item.number < 10 ? '0' + item.number : item.number}}</view
          >
          <view class="answer-content">
            <view class="expected">{{item.answer}}</view>
            <view wx:if="{{item.spoken !== item.answer}}" class="spoken-prompt"
              >朗读提示：{{item.spoken}}</view
            >
            <view
              wx:if="{{item.recognized && (!item.confirmed || item.recognized !== item.answer) && editingIndex !== item.number - 1}}"
              class="recognized-line"
            >
              <text class="recognized-label">作答文字</text
              ><text class="recognized-value">{{item.recognized}}</text>
            </view>
          </view>
          <button
            class="result-adjust"
            data-index="{{item.number - 1}}"
            bindtap="editRow"
            disabled="{{busy}}"
            hover-class="tap-feedback"
            aria-expanded="{{editingIndex === item.number - 1}}"
            aria-label="{{editingIndex === item.number - 1 ? '收起' : '调整'}}第 {{item.number}} 项作答与核查结果"
          >
            <view class="result-status"
              ><text class="status-symbol"
                >{{!item.confirmed ? '·' : item.status === '正确' ? '✓' :
                item.status === '漏写' ? '−' : '×'}}</text
              >{{item.confirmed ? item.status : '待核对'}}</view
            >
            <view class="adjust-label"
              >{{editingIndex === item.number - 1 ? '收起' : item.confirmed ?
              '调整' : item.recognized ? '修正文字' : '录入作答'}}<text
                class="adjust-chevron {{editingIndex === item.number - 1 ? 'is-open' : ''}}"
              ></text
            ></view>
          </button>
        </view>
        <view
          wx:if="{{!item.confirmed || editingIndex === item.number - 1}}"
          class="assessment-actions"
        >
          <button
            class="assess-correct {{item.confirmed && item.status === '正确' ? 'is-selected' : ''}}"
            data-index="{{item.number - 1}}"
            data-status="correct"
            bindtap="assess"
            disabled="{{busy}}"
            hover-class="tap-feedback"
            aria-label="第 {{item.number}} 项写对了"
            aria-pressed="{{item.confirmed && item.status === '正确'}}"
          >
            <text>✓</text> 写对了
          </button>
          <button
            class="assess-wrong {{item.confirmed && item.status === '错误' ? 'is-selected' : ''}}"
            data-index="{{item.number - 1}}"
            data-status="wrong"
            bindtap="assess"
            disabled="{{busy}}"
            hover-class="tap-feedback"
            aria-label="第 {{item.number}} 项写错了"
            aria-pressed="{{item.confirmed && item.status === '错误'}}"
          >
            <text>×</text> 写错了
          </button>
          <button
            class="assess-missing {{item.confirmed && item.status === '漏写' ? 'is-selected' : ''}}"
            data-index="{{item.number - 1}}"
            data-status="missing"
            bindtap="assess"
            disabled="{{busy}}"
            hover-class="tap-feedback"
            aria-label="第 {{item.number}} 项漏写"
            aria-pressed="{{item.confirmed && item.status === '漏写'}}"
          >
            <text>−</text> 漏写
          </button>
        </view>
        <view wx:if="{{editingIndex === item.number - 1}}" class="result-edit">
          <view class="edit-heading"
            >纸上实际写的内容 <text>选填，可修正识别文字</text></view
          >
          <textarea
            class="answer-input {{focusKey === 'answer-' + (item.number - 1) ? 'field-focus' : ''}}"
            value="{{item.recognized}}"
            data-index="{{item.number - 1}}"
            bindinput="edit"
            maxlength="4000"
            placeholder="照着纸面填写，保留原来的拼写"
            disabled="{{busy}}"
            data-focus-key="answer-{{item.number - 1}}"
            bindfocus="focusField"
            bindblur="blurField"
            aria-label="第 {{item.number}} 项纸上实际写的答案"
            cursor-spacing="120"
            auto-height
          />
          <checkbox-group data-index="{{item.number - 1}}" bindchange="check"
            ><label class="confirmation"
              ><checkbox
                value="confirmed"
                checked="{{item.confirmed}}"
                color="#252b25"
                disabled="{{busy}}"
              />已核对作答文字与题号</label
            ></checkbox-group
          >
          <view wx:if="{{item.reason}}" class="reason">{{item.reason}}</view>
          <button
            wx:if="{{item.confirmed}}"
            class="plain mini reset-assessment"
            data-index="{{item.number - 1}}"
            data-status="reset"
            bindtap="assess"
            disabled="{{busy}}"
            hover-class="tap-feedback"
          >
            暂不确定，改为待核对
          </button>
        </view>
      </view>
    </view>
    <view wx:if="{{syncError}}" class="note error"
      ><view>{{syncError}}</view
      ><button
        wx:if="{{syncConflict}}"
        class="plain mini"
        bindtap="reloadCloud"
      >
        处理云端版本冲突
      </button></view
    >
    <button
      wx:if="{{wrong}}"
      class="secondary again"
      bindtap="practiceAgain"
      disabled="{{busy}}"
      hover-class="tap-feedback"
    >
      只复习这次的 {{wrong}} 个错词 →
    </button>
  </block>
</view>
<view wx:if="{{total && !loading}}" class="sticky-actions"
  ><view class="sticky-inner">
    <view
      wx:if="{{undoLabel}}"
      class="assessment-undo between"
      aria-live="polite"
    >
      <text>{{undoLabel}}</text
      ><button
        class="plain mini"
        bindtap="undoAssessment"
        disabled="{{busy}}"
        hover-class="tap-feedback"
      >
        撤销
      </button>
    </view>
    <view class="between"
      ><view class="grow"
        ><view class="action-count">已核对 {{confirmed}} / {{total}} 项</view
        ><view class="small muted"
          >{{syncError ? '同步未完成，可重试' : pending ? '修改已留在本机' :
          confirmed ? '核查结果已保存' : '可以先核对一部分'}}</view
        ></view
      ><button
        wx:if="{{!remaining}}"
        class="primary"
        bindtap="done"
        disabled="{{busy}}"
        loading="{{saving}}"
        hover-class="tap-feedback"
      >
        {{saving ? '保存中…' : pending ? '保存并完成' : '返回练习本'}}</button
      ><button
        wx:else
        class="primary"
        bindtap="save"
        disabled="{{busy || (!pending && !syncError)}}"
        loading="{{saving}}"
        hover-class="tap-feedback"
      >
        {{saving ? '保存中…' : '保存进度'}}
      </button></view
    ></view
  ></view
>
<privacy-gate />
