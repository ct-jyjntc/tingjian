.identity-card { display: flex; align-items: center; gap: 24rpx; margin: 40rpx 0 28rpx; }.avatar { background: #e9edf8; color: #7486bd; font-size: 40rpx; font-weight: 600; width: 104rpx; height: 104rpx; border-radius: 32rpx; text-align: center; line-height: 104rpx; }.identity-title { font-size: 34rpx; font-weight: 600; margin-bottom: 8rpx; }.agreement { display: flex; align-items: flex-start; font-size: 23rpx; color: #9294a2; margin-top: 26rpx; }.agreement checkbox { transform: scale(.8); transform-origin: left top; flex-shrink: 0; }.privacy-links { margin: 14rpx 0 28rpx; padding-left: 52rpx; }.quota-card { background: #f1f2fc; border-color: #e6e8f5; }.quota-card .section-title { font-size: 29rpx; }.quota-number { font-size: 55rpx; color: #6073b2; font-weight: 650; margin: 14rpx 0; }.quota-number text { font-size: 24rpx; color: #969eb9; font-weight: 400; }.quota-note { padding-top: 20rpx; margin-top: 20rpx; border-top: 1rpx solid #e1e5f2; }.sync-note { margin-top: 18rpx; }.menu-card { padding: 0 30rpx; }.menu-item { display: flex; justify-content: space-between; padding: 28rpx 0; border-bottom: 1rpx solid #f0eef2; font-size: 27rpx; }.menu-item:last-child { border: 0; }.menu-item text:last-child { color: #9ba3bd; }.account-actions { margin-top: 24rpx; }.account-actions .small { color: #b0a8a5; font-size: 22rpx; }.footer { text-align: center; font-size: 21rpx; color: #b1b0b9; margin-top: 34rpx; }

.feedback-entry { background: transparent; border-radius: 0; width: 100%; font-weight: 400; text-align: left; line-height: 1.65; }
