.home {
  padding-top: 18rpx;
}
.masthead {
  margin-bottom: 30rpx;
}
.brand-lockup {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}
.brand-emblem {
  width: 58rpx;
  height: 58rpx;
  border-radius: 19rpx;
  background: #f8da65;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 5rpx;
  transform: rotate(-7deg);
}
.brand-emblem view {
  width: 5rpx;
  height: 16rpx;
  border-radius: 4rpx;
  background: #252b25;
}
.brand-emblem view:nth-child(2) {
  height: 28rpx;
}
.brand-emblem view:nth-child(3) {
  height: 36rpx;
}
.brand-emblem view:nth-child(4) {
  height: 22rpx;
}
.wordmark {
  font-size: 38rpx;
  font-weight: 750;
  letter-spacing: -1rpx;
}
.brand-caption {
  font-size: 21rpx;
  color: #73756a;
  margin-left: 8rpx;
}
.profile-shortcut {
  width: 88rpx !important;
  min-width: 88rpx;
  min-height: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff;
  padding: 28rpx;
}
.profile-shortcut image {
  width: 32rpx;
  height: 32rpx;
  display: block;
}
.hero-card {
  min-height: 454rpx;
  padding: 32rpx;
  background: #f8dc70;
  border-radius: 36rpx;
  position: relative;
  overflow: hidden;
}
.hero-tag {
  display: flex;
  align-items: center;
  gap: 9rpx;
  font-size: 22rpx;
  color: #645323;
  letter-spacing: 1rpx;
}
.tag-dot {
  width: 8rpx;
  height: 8rpx;
  background: #6f692f;
  border-radius: 50%;
}
.hero-copy {
  width: 56%;
  position: relative;
  z-index: 2;
}
.hero-title {
  font-size: 57rpx;
  line-height: 1.3;
  font-weight: 750;
  letter-spacing: -2rpx;
  margin-top: 30rpx;
}
.hero-description {
  font-size: 23rpx;
  line-height: 1.6;
  margin-top: 16rpx;
  color: #655a35;
  min-height: 38rpx;
}
.hero-art {
  position: absolute;
  width: 364rpx;
  height: 364rpx;
  right: -34rpx;
  top: 73rpx;
  pointer-events: none;
}
.hero-action {
  position: relative;
  z-index: 2;
  margin-top: 24rpx;
  width: 280rpx;
}
.hero-button {
  width: 100% !important;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 19rpx 26rpx;
  font-size: 27rpx;
  border-radius: 50rpx;
}
.hero-button text:last-child {
  font-size: 34rpx;
  font-weight: 400;
}
.hero-footnote {
  font-size: 20rpx;
  color: #746438;
  margin-top: 22rpx;
  position: relative;
  z-index: 2;
}
.small-spark {
  margin-right: 4rpx;
}
.section-heading {
  margin: 24rpx 0 14rpx;
  min-height: 70rpx;
}
.section-heading .section-title {
  margin: 0;
  font-size: 32rpx;
  letter-spacing: -1rpx;
}
.section-note {
  font-size: 21rpx;
  color: #74796b;
}
.section-link {
  padding: 12rpx 0 12rpx 18rpx;
  font-size: 23rpx;
}
.section-link text {
  margin-left: 8rpx;
}
.entry-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}
.entry-card {
  min-width: 0;
  padding: 23rpx 6rpx 25rpx;
  border-radius: 26rpx;
  background: #fff;
  color: #252b25;
  font-weight: 500;
}
.entry-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 26rpx;
  margin: 0 auto 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.entry-icon image {
  width: 42rpx;
  height: 42rpx;
}
.camera-tint {
  background: #f8e6a5;
}
.album-tint {
  background: #e8eee0;
}
.pen-tint {
  background: #f7e7de;
}
.entry-title {
  font-size: 26rpx;
  font-weight: 650;
}
.entry-caption {
  color: #74796b;
  font-size: 19rpx;
  margin-top: 4rpx;
}
.practice-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.practice-tile {
  text-align: left;
  position: relative;
  padding: 26rpx;
  overflow: hidden;
  min-width: 0;
  min-height: 236rpx;
  border-radius: 30rpx;
  background: #fff;
  color: #252b25;
}
.wrong-tile {
  background: #e9eddf;
}
.tile-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  font-weight: 600;
}
.tile-arrow {
  font-size: 27rpx;
  font-weight: 400;
}
.tile-count {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.25;
  margin-top: 21rpx;
  letter-spacing: -2rpx;
  position: relative;
  z-index: 1;
}
.tile-count text {
  font-size: 22rpx;
  font-weight: 400;
  margin-left: 9rpx;
  color: #73756a;
}
.tile-caption {
  font-size: 20rpx;
  font-weight: 400;
  color: #74796b;
  margin-top: 15rpx;
  position: relative;
  z-index: 1;
}
.mini-book {
  position: absolute;
  right: 28rpx;
  top: 94rpx;
  width: 76rpx;
  height: 90rpx;
  border-radius: 6rpx 13rpx 13rpx 6rpx;
  background: #f8df80;
  border-left: 8rpx solid #e7c251;
  padding: 20rpx 12rpx;
  transform: rotate(12deg);
}
.mini-book view {
  height: 3rpx;
  background: #cab572;
  margin-bottom: 9rpx;
}
.mini-book view:last-child {
  width: 60%;
}
.review-star {
  position: absolute;
  right: 28rpx;
  top: 77rpx;
  color: #b4c398;
  font-size: 106rpx;
  line-height: 1;
  transform: rotate(-13deg);
}
.draft-strip,
.login-strip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 100%;
  font-size: 23rpx;
  font-weight: 400;
  color: #757b69;
  text-align: left;
  background: transparent;
  padding: 24rpx 2rpx;
  margin-top: 12rpx;
}
.draft-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #adb990;
  flex-shrink: 0;
}
.login-strip {
  color: #252b25;
}
.login-strip .small {
  font-size: 22rpx;
  margin-top: 6rpx;
}
.home-signoff {
  text-align: center;
  font-size: 23rpx;
  color: #74796b;
  margin-top: 28rpx;
}
.home-signoff view {
  font-size: 19rpx;
  color: #74796b;
  margin-top: 8rpx;
}
@media (max-width: 360px) {
  .brand-caption {
    display: none;
  }
  .hero-card {
    padding: 28rpx;
  }
  .hero-title {
    font-size: 56rpx;
  }
  .hero-art {
    right: -35rpx;
    top: 82rpx;
    width: 352rpx;
  }
  .entry-caption {
    font-size: 22rpx;
  }
  .entry-title {
    font-size: 29rpx;
  }
  .section-note {
    display: none;
  }
  .tile-caption {
    font-size: 23rpx;
  }
  .draft-strip {
    flex-wrap: wrap;
  }
  .hero-action {
    width: 300rpx;
  }
  .hero-description {
    font-size: 25rpx;
  }
}
