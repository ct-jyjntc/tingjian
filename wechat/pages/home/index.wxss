.masthead { margin: 6rpx 0 36rpx; }.wordmark { font-size: 40rpx; font-weight: 700; letter-spacing: 4rpx; }.brand-dot { color: #8a9acb; margin-left: 6rpx; }
.hero { background: #eef0fc; padding: 38rpx 32rpx 0; border-radius: 32rpx; position: relative; overflow: hidden; min-height: 420rpx; }
.hero .eyebrow { color: #808bb5; font-size: 20rpx; }.hero-title { font-size: 48rpx; line-height: 1.4; letter-spacing: -1rpx; font-weight: 650; position: relative; z-index: 2; }
.hero-copy { color: #838ba7; font-size: 25rpx; margin-top: 20rpx; }.hero-footer { position: relative; z-index: 3; display: flex; gap: 12rpx; align-items: center; font-size: 22rpx; color: #838aaa; border-top: 1rpx solid #e0e4f5; margin-top: 34rpx; padding: 20rpx 0; }.tiny-dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: #93a28a; }
.book-art { position: absolute; right: 26rpx; top: 90rpx; width: 225rpx; height: 260rpx; transform: rotate(-8deg); }.book-back { position: absolute; width: 155rpx; height: 197rpx; border-radius: 12rpx; background: #b5bfdf; top: 30rpx; left: 32rpx; transform: rotate(20deg); box-shadow: 6rpx 9rpx 0 #dce1f2; }.book-front { position: absolute; width: 155rpx; height: 201rpx; border: 2rpx solid #e5d6b6; background: #fff9e9; border-radius: 12rpx; top: 22rpx; left: 10rpx; box-shadow: 5rpx 6rpx 0 #f2e3c6; padding: 26rpx 24rpx; }.book-letter { font-family: Georgia, serif; font-size: 58rpx; color: #8f9dc7; line-height: 1.6; }.book-line { height: 3rpx; background: #e6dcbf; margin: 8rpx 0; }.shorter { width: 65%; }.art-star { position: absolute; right: 0; top: -22rpx; color: #d9bc74; font-size: 55rpx; }.art-orbit { position: absolute; right: 5rpx; bottom: 2rpx; width: 25rpx; height: 25rpx; border: 3rpx solid #a6b3dd; border-radius: 50%; }
.capture-actions { display: flex; gap: 18rpx; margin-top: 26rpx; }.capture-actions .primary { flex: 1.25; }.capture-actions .secondary { flex: 1; }.button-arrow { margin-left: 18rpx; }.manual { width: 100%; font-size: 25rpx; margin-top: 8rpx; }.manual text { margin-left: 12rpx; }.login-note { display: flex; justify-content: space-between; font-size: 23rpx; padding: 22rpx 24rpx; background: #f6f0e5; border-radius: 18rpx; color: #a08c66; margin-top: 16rpx; }.section-heading { margin-top: 42rpx; }.section-heading .section-title { margin: 0; }.resume, .draft-row { display: flex; align-items: center; justify-content: space-between; }.resume-title { font-size: 30rpx; font-weight: 600; margin: 10rpx 0 4rpx; }.resume-arrow { font-size: 38rpx; color: #6578bd; background: #f0f1fa; padding: 4rpx 18rpx; border-radius: 50%; }.empty-book { color: #b9bdcd; font-size: 65rpx; margin-bottom: 8rpx; }.stats { display: flex; justify-content: center; align-items: center; text-align: center; gap: 70rpx; padding: 40rpx 0; }.stat-number { font-size: 45rpx; color: #646d93; font-weight: 600; }.stat-divider { background: #e9e7ed; width: 1rpx; height: 60rpx; }.home-footnote { text-align: center; color: #b0b0b8; font-size: 21rpx; padding: 6rpx 0 22rpx; }
