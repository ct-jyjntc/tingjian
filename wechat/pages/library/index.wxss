.library-tabs { display: flex; background: #eeedf4; padding: 8rpx; border-radius: 22rpx; margin-top: 32rpx; gap: 8rpx; }.library-tabs button { flex: 1; padding: 18rpx 12rpx; font-size: 26rpx; background: transparent; color: #9698a9; }.library-tabs .active { background: #fffefa; color: #5f71b2; box-shadow: 0 3rpx 12rpx #e4e3ee; }.history-title { font-size: 33rpx; font-weight: 600; margin: 12rpx 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.history-footer { display: flex; justify-content: flex-end; border-top: 1rpx solid #f0eef1; margin-top: 22rpx; padding-top: 8rpx; }.history-card { padding-bottom: 16rpx; }.wrong-card { display: flex; gap: 20rpx; align-items: center; }.wrong-answer { font-size: 35rpx; font-weight: 600; word-break: break-word; }.review-button,.login-button { margin-top: 32rpx; }
