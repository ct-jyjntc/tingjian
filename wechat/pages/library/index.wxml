<view
  class="page tab-page library {{loggedIn && tab === 'wrong' && (wrong.length || removedWord) ? 'with-actions' : ''}}"
>
  <view class="library-cover"
    ><view class="page-header"
      ><view class="eyebrow">练过的，都在这里</view
      ><view class="page-title">我的练习本</view
      ><view class="page-description">练习有记录，进步看得见。</view></view
    >
    <view class="shelf-art" aria-hidden="true"
      ><view class="shelf-book back">听</view
      ><view class="shelf-book front"
        ><text>练习本</text><view></view><view></view></view
      ><view class="shelf-spark">✦</view></view
    ></view
  >
  <view wx:if="{{error && (history.length || wrong.length)}}" class="note error"
    ><view>{{error}}</view
    ><button class="plain mini" bindtap="refresh">重试刷新</button></view
  >
  <view class="segmented library-tabs"
    ><button
      hover-class="tap-feedback"
      hover-stay-time="80"
      class="{{tab === 'history' ? 'active' : ''}}"
      data-tab="history"
      bindtap="tab"
      aria-pressed="{{tab === 'history'}}"
    >
      听写记录{{loggedIn && !loading && !error ? ' · ' + history.length : ''}}</button
    ><button
      hover-class="tap-feedback"
      hover-stay-time="80"
      class="{{tab === 'wrong' ? 'active' : ''}}"
      data-tab="wrong"
      bindtap="tab"
      aria-pressed="{{tab === 'wrong'}}"
    >
      错词本{{loggedIn && !loading && !error ? ' · ' + wrong.length : ''}}
    </button></view
  >
  <view wx:if="{{!loggedIn}}" class="card empty"
    ><view class="empty-symbol">听</view
    ><view class="empty-title">登录后，练习会留在这里</view
    ><view>清单、记录和错词，归在同一个账号下。</view
    ><button
      hover-class="tap-feedback"
      hover-stay-time="80"
      class="primary login-button"
      bindtap="login"
    >
      微信登录
    </button></view
  >
  <view wx:elif="{{loading}}" class="card state-panel"
    ><view class="loading-indicator"></view
    ><text class="muted">正在整理练习本…</text></view
  >
  <view
    wx:elif="{{error && !history.length && !wrong.length}}"
    class="note error"
    ><view class="note-title">暂时无法读取练习</view><view>{{error}}</view
    ><button
      hover-class="tap-feedback"
      hover-stay-time="80"
      class="plain mini"
      bindtap="refresh"
    >
      重新加载
    </button></view
  >
  <block wx:elif="{{tab === 'history'}}">
    <view wx:if="{{!history.length}}" class="card empty"
      ><view class="empty-symbol">＋</view
      ><view class="empty-title">从第一次听写开始</view
      ><view>完成练习后，在这里拍照核查答案。</view
      ><button
        hover-class="tap-feedback"
        hover-stay-time="80"
        class="primary login-button"
        bindtap="home"
      >
        去准备清单
      </button></view
    >
    <view wx:for="{{history}}" wx:key="key" class="card history-card"
      ><button
        hover-class="tap-feedback"
        hover-stay-time="80"
        class="history-main between"
        data-key="{{item.key}}"
        bindtap="open"
      >
        <view
          class="history-cover {{index % 2 ? 'sage' : 'yellow'}}"
          aria-hidden="true"
          ><text>听写</text><view class="cover-lines"></view
          ><text class="cover-count">{{item.count}}<text>项</text></text></view
        ><view class="grow"
          ><view class="small muted">{{item.date}}</view
          ><view class="history-title">{{item.title}}</view
          ><view class="small muted"
            >{{item.count}} 项 · 听写已确认 {{item.confirmedCount}} 项</view
          ></view
        ><text class="history-arrow" aria-hidden="true">↗</text></button
      ><view class="history-footer"
        ><text class="small muted">查看答案与核查结果</text
        ><button
          hover-class="tap-feedback"
          hover-stay-time="80"
          class="plain mini"
          data-key="{{item.key}}"
          data-revision="{{item.revision}}"
          bindtap="moreHistory"
          disabled="{{busy}}"
        >
          更多 ···
        </button></view
      ></view
    >
  </block>
  <block wx:else>
    <view class="between selection-toolbar"
      ><view class="small muted"
        >已选 {{selectedCount}} / {{wrong.length}} 个词</view
      ><button
        class="plain mini"
        bindtap="selectAll"
        disabled="{{busy}}"
        hover-class="tap-feedback"
      >
        {{selectedCount === wrong.length ? '取消全选' : '全选'}}
      </button></view
    >
    <view wx:if="{{!wrong.length}}" class="card empty"
      ><view class="empty-symbol">✓</view
      ><view class="empty-title">暂时没有待复习的错词</view
      ><view>完成听写并保存核查结果后，错词会自动整理到这里。</view></view
    >
    <checkbox-group bindchange="selection"
      ><view wx:for="{{wrong}}" wx:key="id" class="card wrong-card"
        ><label class="grow row word-selection"
          ><checkbox
            value="{{item.id}}"
            checked="{{item.selected}}"
            color="#252b25"
            disabled="{{busy}}"
          /><view class="grow"
            ><view class="wrong-answer">{{item.answer}}</view
            ><view
              class="small muted preserve"
              wx:if="{{item.spoken !== item.answer}}"
              >提示：{{item.spoken}}</view
            ></view
          ></label
        ><button
          hover-class="tap-feedback"
          hover-stay-time="80"
          class="mini secondary"
          data-id="{{item.id}}"
          bindtap="removeWrong"
          disabled="{{busy}}"
        >
          已记住 ✓
        </button></view
      ></checkbox-group
    >
  </block>
</view>
<view
  wx:if="{{loggedIn && !loading && tab === 'wrong' && (wrong.length || removedWord)}}"
  class="sticky-actions library-actions"
  ><view class="sticky-inner">
    <view wx:if="{{removedWord}}" class="note success between"
      ><text class="grow">已移出 {{removedWord}}</text
      ><button class="plain mini" bindtap="undoRemove" disabled="{{busy}}">
        撤销
      </button></view
    >
    <view wx:if="{{wrong.length}}" class="between library-selection-action"
      ><view class="grow"
        ><view class="section-title">已选 {{selectedCount}} 个词</view
        ><view class="small muted">只把选中的词加入复习清单</view></view
      ><button
        hover-class="tap-feedback"
        hover-stay-time="80"
        class="primary"
        bindtap="review"
        disabled="{{busy || !selectedCount}}"
        loading="{{busy}}"
      >
        {{selectedCount ? '复习所选 →' : '先选要练的词'}}
      </button></view
    ></view
  ></view
>
