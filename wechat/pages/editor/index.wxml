<view class="page with-actions editor">
  <view class="steps"
    ><text class="current">01 准备清单</text><view class="step-line"></view
    ><text>02 听写</text><view class="step-line"></view
    ><text>03 核查</text></view
  ><view class="page-header editor-header"
    ><view class="page-title">准备听写清单</view
    ><view class="page-description"
      >先核对内容，再按自己的节奏开始。</view
    ></view
  >
  <view wx:if="{{error}}" class="note error"
    ><view class="note-title">清单暂时无法加载</view><view>{{error}}</view
    ><button
      hover-class="tap-feedback"
      hover-stay-time="80"
      class="plain mini"
      bindtap="retryLoad"
    >
      重新加载
    </button></view
  >
  <view wx:if="{{loading}}" class="card state-panel"
    ><view class="loading-indicator"></view
    ><text class="muted">正在取出你的清单…</text></view
  >
  <block wx:elif="{{!error}}">
    <view class="card import-card">
      <button
        hover-class="tap-feedback"
        hover-stay-time="80"
        class="fold-header between"
        data-panel="showImport"
        bindtap="togglePanel"
        aria-expanded="{{showImport}}"
      >
        <view class="grow"
          ><view class="section-title">添加听写内容</view
          ><view class="fold-summary">拍照识别，或直接输入文字</view></view
        ><text class="fold-indicator"
          >{{showImport ? '收起 −' : '展开 ＋'}}</text
        >
      </button>
      <view hidden="{{!showImport}}" class="fold-content">
        <view class="segmented"
          ><button
            hover-class="tap-feedback"
            hover-stay-time="80"
            class="{{inputMode === 'text' ? 'active' : ''}}"
            data-mode="text"
            bindtap="inputMode"
            disabled="{{busy}}"
            aria-pressed="{{inputMode === 'text'}}"
          >
            手动输入</button
          ><button
            hover-class="tap-feedback"
            hover-stay-time="80"
            class="{{inputMode === 'photo' ? 'active' : ''}}"
            data-mode="photo"
            bindtap="inputMode"
            disabled="{{busy}}"
            aria-pressed="{{inputMode === 'photo'}}"
          >
            照片识别
          </button></view
        >
        <view hidden="{{inputMode !== 'photo'}}"
          ><button
            hover-class="tap-feedback"
            hover-stay-time="80"
            class="photo-picker"
            bindtap="chooseImage"
            disabled="{{busy}}"
          >
            <view class="photo-picker-symbol" aria-hidden="true">＋</view
            ><view>{{photo ? '更换照片' : '拍照或从相册选择'}}</view
            ><view class="small muted">识别前可以裁剪和旋转</view>
          </button>
          <block wx:if="{{photo}}"
            ><image
              class="source-photo"
              src="{{photo}}"
              mode="aspectFit"
              bindtap="previewPhoto"
            /><view class="row photo-actions"
              ><button
                hover-class="tap-feedback"
                hover-stay-time="80"
                class="mini"
                bindtap="crop"
                disabled="{{busy}}"
              >
                裁剪 / 旋转</button
              ><button
                hover-class="tap-feedback"
                hover-stay-time="80"
                class="mini plain"
                bindtap="restorePhoto"
                disabled="{{busy}}"
              >
                恢复原图
              </button></view
            ><view class="field-label">识别方式</view
            ><picker
              range="{{modes}}"
              value="{{mode}}"
              bindchange="modeChange"
              disabled="{{busy}}"
              ><view class="picker between"
                >{{modes[mode]}} <text>⌄</text></view
              ></picker
            ><button
              hover-class="tap-feedback"
              hover-stay-time="80"
              class="primary recognize"
              bindtap="recognize"
              disabled="{{busy}}"
              loading="{{taskKind === 'ocr'}}"
            >
              {{taskKind === 'ocr' ? '正在识别…' : '识别并加入清单'}}
            </button></block
          >
        </view>
        <view hidden="{{inputMode !== 'text'}}">
          <view class="field-label">直接输入 · 每行一项</view
          ><textarea
            class="{{focusKey === 'field-1' ? 'field-focus' : ''}}"
            value="{{inputText}}"
            bindinput="textInput"
            maxlength="30000"
            disabled="{{busy}}"
            placeholder="{{inputPlaceholder}}"
            data-focus-key="field-1"
            bindfocus="focusField"
            aria-label="每行输入一项听写内容"
            bindblur="blurField"
            cursor-spacing="40"
          />
          <view class="between input-footer"
            ><text class="small muted">提示与答案不同，用 → 分开</text
            ><button
              hover-class="tap-feedback"
              hover-stay-time="80"
              class="mini"
              bindtap="addText"
              disabled="{{busy || !inputText}}"
            >
              加入清单
            </button></view
          >
        </view>
      </view>
    </view>
    <view wx:if="{{taskError}}" class="note error"
      ><view class="note-title">任务未完成，清单已保留</view
      ><view>{{taskError}}</view
      ><view class="small">检查网络后，可再次点击识别或整理按钮。</view></view
    >
    <view wx:if="{{message}}" class="note preserve">{{message}}</view
    ><button
      hover-class="tap-feedback"
      hover-stay-time="80"
      wx:if="{{taskKind}}"
      class="plain"
      bindtap="cancel"
    >
      取消当前 AI 任务
    </button>
    <view id="assistant-card" class="card agent-card">
      <button
        hover-class="tap-feedback"
        hover-stay-time="80"
        class="fold-header between"
        data-panel="showAssistant"
        bindtap="togglePanel"
        aria-expanded="{{showAssistant}}"
      >
        <view class="grow"
          ><view class="section-title"
            >AI 整理助手 <text class="badge">可选</text></view
          ><view class="fold-summary"
            >筛选内容、整理词形，先预览再应用</view
          ></view
        ><text class="fold-indicator"
          >{{showAssistant ? '收起 −' : '展开 ＋'}}</text
        >
      </button>
      <view hidden="{{!showAssistant}}" class="fold-content">
        <view wx:if="{{!count}}" class="small muted"
          >先添加听写内容，再让助手帮你整理。</view
        >
        <textarea
          class="{{focusKey === 'field-2' ? 'field-focus' : ''}} agent-input"
          value="{{instruction}}"
          bindinput="instructionInput"
          maxlength="3000"
          disabled="{{busy}}"
          placeholder="例如：只听写过去式，每个单词一项"
          data-focus-key="field-2"
          bindfocus="focusField"
          aria-label="给 AI 的整理要求"
          bindblur="blurField"
          cursor-spacing="40"
        />
        <view class="between setting-line"
          ><view
            ><view>允许 AI 辅助出题</view
            ><view class="small muted">关闭时，只整理原文</view></view
          ><switch
            color="#252b25"
            checked="{{generate}}"
            bindchange="generateChange"
            disabled="{{busy}}"
        /></view>
        <button
          hover-class="tap-feedback"
          hover-stay-time="80"
          class="secondary"
          bindtap="ask"
          loading="{{taskKind === 'agent'}}"
          disabled="{{busy || !instruction || !count}}"
        >
          {{taskKind === 'agent' ? '正在准备…' : '请帮我整理清单'}}
        </button>
        <block wx:if="{{columns.length}}"
          ><view class="field-label">最近一张材料 · 按列快捷整理</view
          ><view class="chips"
            ><button
              hover-class="tap-feedback"
              hover-stay-time="80"
              wx:for="{{columns}}"
              wx:key="*this"
              class="chip"
              data-column="{{item}}"
              bindtap="column"
              disabled="{{busy}}"
            >
              第 {{item}} 列
            </button></view
          ></block
        >
        <view wx:if="{{proposalMessage}}" class="proposal"
          ><view class="preserve">{{proposalMessage}}</view
          ><view wx:for="{{trace}}" wx:key="index" class="trace"
            ><text
              >{{item.status === 'success' ? '✓' : '·'}} {{item.label}}</text
            ><view class="small muted">{{item.detail}}</view></view
          ><view wx:for="{{proposal}}" wx:key="id" class="proposal-item"
            ><text>{{item.number}}.</text
            ><view class="grow"
              >{{item.spoken}}<text wx:if="{{item.spoken !== item.answer}}">
                → {{item.answer}}</text
              ><view wx:if="{{item.generated}}" class="badge warm"
                >AI 生成</view
              ></view
            ></view
          ><view class="row"
            ><button
              hover-class="tap-feedback"
              hover-stay-time="80"
              wx:if="{{proposal.length}}"
              class="primary grow"
              bindtap="apply"
            >
              确认使用这份草稿</button
            ><button
              hover-class="tap-feedback"
              hover-stay-time="80"
              class="plain"
              bindtap="discard"
            >
              收起
            </button></view
          ></view
        >
      </view>
    </view>
    <view class="between list-heading"
      ><view class="section-title"
        >听写清单 <text class="muted">{{count}} 项</text></view
      ><button
        hover-class="tap-feedback"
        hover-stay-time="80"
        class="plain mini"
        bindtap="undo"
        disabled="{{!undoable || busy}}"
      >
        撤销
      </button></view
    >
    <input
      class="{{focusKey === 'field-3' ? 'field-focus' : ''}} list-title"
      value="{{title}}"
      bindblur="titleInput"
      maxlength="100"
      placeholder="清单名称，例如：第三课生词"
      disabled="{{busy}}"
      data-focus-key="field-3"
      bindfocus="focusField"
      aria-label="清单名称"
      cursor-spacing="40"
    />
    <view wx:if="{{issueCount}}" class="note"
      >有 {{issueCount}} 项需要对照课本核查，确认后才能开始。</view
    >
    <view wx:if="{{!count}}" class="card empty"
      ><view class="empty-symbol">＋</view
      ><view class="empty-title">把第一项内容加进来</view
      ><view>在上方输入文字或选择照片，清单会显示在这里。</view></view
    >
    <view wx:for="{{items}}" wx:key="id" class="item-card">
      <button
        hover-class="tap-feedback"
        hover-stay-time="80"
        class="item-summary between"
        data-id="{{item.id}}"
        bindtap="edit"
        disabled="{{busy}}"
        aria-expanded="{{editingId === item.id}}"
      >
        <view class="item-number">{{item.number}}</view
        ><view class="grow"
          ><view class="item-spoken">{{item.spoken || '待补全内容'}}</view
          ><view wx:if="{{item.spoken !== item.answer}}" class="small muted"
            >答案：{{item.answer || '待补全'}}</view
          ><view wx:if="{{item.generated}}" class="badge warm"
            >AI 生成 · 请核查</view
          ></view
        ><text class="small link"
          >{{editingId === item.id ? '收起' : '编辑'}}</text
        >
      </button>
      <view wx:if="{{item.issue}}" class="note small"
        >{{item.issue}}<button
          hover-class="tap-feedback"
          hover-stay-time="80"
          class="mini plain"
          data-id="{{item.id}}"
          bindtap="reviewed"
          disabled="{{busy}}"
        >
          已对照原文，确认无误 ✓
        </button></view
      >
      <view wx:if="{{editingId === item.id}}" class="item-edit"
        ><view class="field-label">朗读内容</view
        ><input
          class="{{focusKey === 'spoken-' + item.id ? 'field-focus' : ''}}"
          value="{{item.spoken}}"
          data-id="{{item.id}}"
          data-field="spoken"
          bindblur="field"
          maxlength="1000"
          disabled="{{busy}}"
          data-focus-key="spoken-{{item.id}}"
          bindfocus="focusField"
          aria-label="朗读内容"
          cursor-spacing="40"
        /><view class="field-label">标准答案</view
        ><input
          class="{{focusKey === 'answer-' + item.id ? 'field-focus' : ''}}"
          value="{{item.answer}}"
          data-id="{{item.id}}"
          data-field="answer"
          bindblur="field"
          maxlength="1000"
          disabled="{{busy}}"
          data-focus-key="answer-{{item.id}}"
          bindfocus="focusField"
          aria-label="标准答案"
          cursor-spacing="40"
        /><view class="field-label">发音替换（可选）</view
        ><input
          class="{{focusKey === 'pronunciation-' + item.id ? 'field-focus' : ''}}"
          value="{{item.pronunciation}}"
          data-id="{{item.id}}"
          data-field="pronunciation"
          bindblur="field"
          maxlength="1000"
          disabled="{{busy}}"
          placeholder="只影响发音，不修改标准答案"
          data-focus-key="pronunciation-{{item.id}}"
          bindfocus="focusField"
          aria-label="发音替换"
          cursor-spacing="40"
        /><view class="small muted source-label">来源：{{item.source}}</view
        ><view class="row"
          ><button
            hover-class="tap-feedback"
            hover-stay-time="80"
            class="mini"
            data-id="{{item.id}}"
            data-delta="-1"
            bindtap="move"
            disabled="{{busy || index === 0}}"
          >
            上移</button
          ><button
            hover-class="tap-feedback"
            hover-stay-time="80"
            class="mini"
            data-id="{{item.id}}"
            data-delta="1"
            bindtap="move"
            disabled="{{busy || index === count - 1}}"
          >
            下移</button
          ><button
            hover-class="tap-feedback"
            hover-stay-time="80"
            class="mini plain danger"
            data-id="{{item.id}}"
            bindtap="remove"
            disabled="{{busy}}"
          >
            删除
          </button></view
        ></view
      >
    </view>
    <view class="row list-tools"
      ><button
        hover-class="tap-feedback"
        hover-stay-time="80"
        class="mini"
        bindtap="splitWords"
        disabled="{{!count || busy}}"
      >
        按英文单词拆分</button
      ><button
        hover-class="tap-feedback"
        hover-stay-time="80"
        wx:if="{{sourceText}}"
        class="plain mini"
        bindtap="toggleSources"
      >
        {{showSources ? '收起原文' : '查看识别原文'}}
      </button></view
    >
    <view wx:if="{{showSources}}" class="card preserve small"
      >{{sourceText}}</view
    >
    <view class="card settings-card">
      <button
        hover-class="tap-feedback"
        hover-stay-time="80"
        class="fold-header between"
        data-panel="showSettings"
        bindtap="togglePanel"
        aria-expanded="{{showSettings}}"
      >
        <view class="grow"
          ><view class="section-title">朗读设置</view
          ><view class="fold-summary"
            >{{settings.speed}} 倍速 · 每项 {{settings.repeats}} 遍 ·
            {{settings.order === 'random' ? '随机顺序' : '原文顺序'}}</view
          ></view
        ><text class="fold-indicator"
          >{{showSettings ? '收起 −' : '调整 ＋'}}</text
        >
      </button>
      <view hidden="{{!showSettings}}" class="fold-content"
        ><view class="muted">每项读完后等你，写好了再继续。</view>
        <view class="field-label">朗读声音</view
        ><picker
          range="{{voices}}"
          range-key="label"
          value="{{voiceIndex}}"
          bindchange="voice"
          ><view class="picker between"
            >{{voices[voiceIndex].label}} <text>⌄</text></view
          ></picker
        >
        <view class="field-label">语速 · {{settings.speed}} 倍</view
        ><slider
          min="50"
          max="150"
          step="10"
          value="{{speedPercent}}"
          activeColor="#252b25"
          block-size="20"
          bindchange="speed"
        />
        <view class="field-label">每项朗读</view
        ><picker
          range="{{repeatLabels}}"
          value="{{repeatIndex}}"
          bindchange="repeats"
          ><view class="picker">{{repeatLabels[repeatIndex]}}</view></picker
        >
        <view wx:if="{{settings.repeats > 1}}"
          ><view class="field-label">重复间隔 · {{settings.gap}} 秒</view
          ><slider
            min="0"
            max="5"
            step="1"
            value="{{settings.gap}}"
            activeColor="#252b25"
            block-size="20"
            bindchange="gap"
        /></view>
        <view class="between setting-line"
          ><text>随机排列本次内容</text
          ><switch
            checked="{{settings.order === 'random'}}"
            bindchange="random"
            color="#252b25"
        /></view>
        <view class="between setting-line"
          ><text>允许向助手提问和求提示</text
          ><switch
            checked="{{settings.allowHints}}"
            bindchange="hints"
            color="#252b25"
        /></view>
        <view class="between setting-line"
          ><text>练习时显示答案</text
          ><switch
            checked="{{settings.showAnswer}}"
            bindchange="answers"
            color="#252b25"
        /></view>
        <button
          hover-class="tap-feedback"
          hover-stay-time="80"
          class="secondary"
          bindtap="preview"
          disabled="{{!count || busy || previewing}}"
          loading="{{previewing}}"
        >
          {{previewing ? '正在试听…' : '试听第一项'}}
        </button></view
      >
    </view>
    <view wx:if="{{pending}}" class="note"
      ><view>本机有尚未同步的修改</view
      ><view class="row"
        ><button
          hover-class="tap-feedback"
          hover-stay-time="80"
          class="mini plain"
          bindtap="save"
        >
          立即同步</button
        ><button
          hover-class="tap-feedback"
          hover-stay-time="80"
          class="mini plain"
          bindtap="cloudVersion"
        >
          载入云端版本
        </button></view
      ></view
    >
  </block>
</view>
<view class="sticky-actions"
  ><view class="sticky-inner between"
    ><view class="grow"
      ><view class="action-count">{{count}} 项内容</view
      ><view class="small {{issueCount ? 'issue-label' : 'muted'}}"
        >{{loading ? '正在加载…' : error ? '请先重新加载清单' : issueCount ?
        issueCount + ' 项待核查' : !count ? '先添加听写内容' :
        '每项写好后，再继续'}}</view
      ></view
    ><button
      hover-class="tap-feedback"
      hover-stay-time="80"
      class="primary"
      bindtap="start"
      loading="{{starting}}"
      disabled="{{loading || busy || !count || issueCount || error}}"
    >
      {{starting ? '准备中…' : '开始听写 →'}}
    </button></view
  ></view
>
<privacy-gate />
